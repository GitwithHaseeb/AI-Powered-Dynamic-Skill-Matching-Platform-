# Copy to .env and fill in values. Do not commit .env.

# MongoDB (SDS: use Atlas URI in Compass). Either MONGO_URI or MONGODB_URL:
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/skill_mapping?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/skill_mapping?retryWrites=true&w=majority
MONGODB_DB_NAME=skill_mapping
# Only if Python TLS handshake fails (broken proxy). Not for production:
MONGODB_TLS_INSECURE=false

DEBUG=True
HOST=0.0.0.0
# Default API port — must match `uvicorn --port` and `frontend/vite.config.js` proxy target (8000).
PORT=8000
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Dev only: allow registering users with role=admin via /auth/register
ALLOW_PUBLIC_ADMIN_REG=false

# AI team size per project (stratified top picks; default 5)
MAX_PROJECT_TEAM_SIZE=5

# Chatbot: rules | hybrid (Ollama fallback) | local_llm (rules fallback if Ollama down)
CHATBOT_MODE=hybrid
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_NUM_PREDICT=80

# Matcher timeout for recommendations scoring (seconds; top-5 stratified roster)
RECOMMENDATIONS_MATCHER_TIMEOUT=20
