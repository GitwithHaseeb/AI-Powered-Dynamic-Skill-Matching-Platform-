{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install deps (venv312)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv312/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Backend: uvicorn (8000)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/venv312/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {}
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": ".",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Waiting for application startup",
          "endsPattern": "Application startup complete|Connected to MongoDB"
        }
      }
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Frontend: npm run dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": ".",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "ready in|Local:"
        }
      }
    },
    {
      "label": "Full stack: Backend then Frontend",
      "dependsOrder": "sequence",
      "dependsOn": ["Backend: uvicorn (8000)", "Frontend: npm run dev"],
      "problemMatcher": []
    }
  ]
}
