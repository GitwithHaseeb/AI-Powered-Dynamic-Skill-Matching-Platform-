# Copy to .env — dev uses Vite proxy to the API (see vite.config.js).
# Backend must run on the same port as vite.config.js proxy (default http://127.0.0.1:8000).
VITE_API_URL=/api

# Optional: analytics PDF/report routes can take ~30s on large MongoDB data (default 90000).
# VITE_ANALYTICS_TIMEOUT_MS=90000

# Optional: general API timeout in ms (default 25000).
# VITE_API_TIMEOUT_MS=25000
